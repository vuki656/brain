{
    "name": "obsidian-vuki-kanban",
    "version": "2.16.0",
    "description": "Custom Kanban board plugin for Obsidian",
    "main": "main.js",
    "scripts": {
        "build": "tsc -noEmit -skipLibCheck && bun build.ts production",
        "dev": "bun --watch build.ts",
        "lint": "bun lint:eslint && bun lint:prettier && bun lint:stylelint && bun lint:cspell && bun lint:knip",
        "lint:cspell": "cspell --no-progress --no-summary --unique '**'",
        "lint:eslint": "eslint . --cache --concurrency=auto",
        "lint:fix": "bun lint:eslint --fix && bun lint:prettier --write && bun lint:stylelint --fix",
        "lint:knip": "knip",
        "lint:prettier": "prettier --check --cache .",
        "lint:stylelint": "stylelint ./**/*.css --cache",
        "test": "bun test",
        "test:watch": "bun test --watch"
    },
    "dependencies": {
        "monkey-around": "^3.0.0",
        "sortablejs": "^1.15.3"
    },
    "devDependencies": {
        "@dvukovic/style-guide": "^0.16.0",
        "@types/bun": "^1.3.9",
        "@types/sortablejs": "^1.15.8",
        "cspell": "^9.7.0",
        "eslint": "9",
        "knip": "^5.85.0",
        "obsidian": "latest",
        "prettier": "^3.8.1",
        "stylelint": "^17.4.0",
        "tslib": "^2.8.0",
        "typescript": "^5.6.0"
    }
}
