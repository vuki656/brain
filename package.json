{
    "name": "obsidian-vuki-kanban",
    "version": "2.30.4",
    "description": "Custom Kanban board plugin for Obsidian",
    "repository": {
        "type": "git",
        "url": "https://github.com/vuki656/brain"
    },
    "license": "UNLICENSED",
    "author": "Domagoj Vukovic",
    "main": "main.js",
    "scripts": {
        "build": "tsc -noEmit && bun build.ts production",
        "lint": "bun lint:eslint && bun lint:prettier && bun lint:stylelint && bun lint:cspell && bun lint:knip",
        "lint:cspell": "cspell --no-progress --no-summary --unique '**'",
        "lint:eslint": "eslint . --cache --concurrency=auto",
        "lint:fix": "bun lint:eslint --fix && bun lint:prettier --write && bun lint:stylelint --fix && bun lint:cspell && bun lint:knip",
        "lint:knip": "knip",
        "lint:prettier": "prettier --check --cache .",
        "lint:stylelint": "stylelint ./**/*.css --cache",
        "test": "bun test"
    },
    "dependencies": {
        "date-fns": "4.1.0",
        "monkey-around": "3.0.0",
        "sortablejs": "1.15.7"
    },
    "devDependencies": {
        "@dvukovic/style-guide": "0.24.1",
        "@types/bun": "1.3.11",
        "@types/sortablejs": "1.15.9",
        "cspell": "9.7.0",
        "eslint": "9.39.3",
        "knip": "6.0.5",
        "obsidian": "1.12.3",
        "prettier": "3.8.1",
        "stylelint": "17.5.0",
        "typescript": "6.0.2"
    },
    "engines": {
        "node": ">=24.0.0",
        "obsidian": ">=1.0.0"
    },
    "volta": {
        "node": "24.14.0"
    }
}
